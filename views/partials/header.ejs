<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>SuratKilat Pro</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col font-sans">
  <header class="no-print bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <a href="/" class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-base shadow-sm">
          <i class="fa-solid fa-file-signature"></i>
        </a>
        <div>
          <a href="/" class="text-base font-bold text-slate-900 leading-tight block">SuratKilat Pro</a>
          <p class="text-[11px] text-slate-500">Generator & Sistem Arsip Surat Resmi</p>
        </div>
      </div>
      
      <nav class="flex items-center gap-2">
        <a href="/" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg <%= activePage === 'home' ? 'bg-blue-50 text-blue-600' : 'text-slate-600 hover:bg-slate-100' %>">
          <i class="fa-solid fa-pen-nib mr-1"></i> Editor
        </a>
        <a href="/history" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg <%= activePage === 'history' ? 'bg-blue-50 text-blue-600' : 'text-slate-600 hover:bg-slate-100' %>">
          <i class="fa-solid fa-folder-open mr-1"></i> Arsip Surat
        </a>
      </nav>
    </div>
  </header>