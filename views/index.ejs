<%- include('partials/header') %>

<!-- Mobile Tab Switcher -->
<div class="no-print lg:hidden bg-white border-b border-slate-200 sticky top-[57px] z-20 px-4 py-2">
  <div class="flex bg-slate-100 p-1 rounded-xl">
    <button id="tabFormBtn" class="flex-1 py-2 text-xs font-bold rounded-lg bg-white text-blue-600 shadow-sm flex items-center justify-center gap-1.5">
      <i class="fa-solid fa-pen-to-square"></i> Form Editor
    </button>
    <button id="tabPreviewBtn" class="flex-1 py-2 text-xs font-semibold rounded-lg text-slate-600 flex items-center justify-center gap-1.5">
      <i class="fa-regular fa-file-lines"></i> Kertas A4
    </button>
  </div>
</div>

<main class="max-w-7xl mx-auto w-full p-3 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1 items-start">
  
  <!-- Form Section -->
  <div id="formSection" class="no-print lg:col-span-5 bg-white rounded-2xl border border-slate-200 shadow-xs p-4 sm:p-6 space-y-5">
    <div class="flex items-center justify-between">
      <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Pilih Template</label>
      <button id="btnSaveDb" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white flex items-center gap-1.5">
        <i class="fa-solid fa-cloud-arrow-up"></i> Simpan Arsip
      </button>
    </div>
    
    <select id="templateSelector" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500">
      <option value="lamaran">Surat Lamaran Pekerjaan</option>
      <option value="izin">Surat Izin Tidak Masuk</option>
      <option value="resign">Surat Pengunduran Diri (Resign)</option>
      <option value="pernyataan">Surat Pernyataan Kesanggupan</option>
      <option value="rapat">Surat Undangan Rapat Resmi</option>
    </select>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-[11px] font-semibold text-slate-600 mb-1">Font Dokumen</label>
        <select id="fontFamily" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs text-slate-700">
          <option value="font-times">Times New Roman</option>
          <option value="font-arial">Arial</option>
          <option value="font-calibri">Calibri</option>
          <option value="font-garamond">Garamond</option>
        </select>
      </div>
      <div>
        <label class="block text-[11px] font-semibold text-slate-600 mb-1">Ukuran Font</label>
        <select id="fontSize" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs text-slate-700">
          <option value="text-sm">11 pt (Standar)</option>
          <option value="text-xs">10 pt (Kecil)</option>
          <option value="text-base">12 pt (Besar)</option>
        </select>
      </div>
    </div>

    <hr class="border-slate-100" />

    <!-- Kop Surat -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <label for="toggleKop" class="text-xs font-bold text-slate-600 uppercase tracking-wider cursor-pointer">Sertakan Kop Surat</label>
        <input type="checkbox" id="toggleKop" class="w-4 h-4 text-blue-600 rounded border-slate-300" />
      </div>
      <div id="kopFields" class="space-y-2.5 hidden bg-slate-50 p-3 sm:p-4 rounded-xl border border-slate-200">
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Nama Instansi</label>
          <input type="text" id="kopNama" value="PT NUSANTARA JAYA ABADI" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs" />
        </div>
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Alamat Lengkap</label>
          <input type="text" id="kopAlamat" value="Gedung Cyber Tower Lt. 12, Jakarta" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs" />
        </div>
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Kontak</label>
          <input type="text" id="kopKontak" value="Telp: (021) 555-0199 | info@nusantarajaya.co.id" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs" />
        </div>
      </div>
    </div>

    <hr class="border-slate-100" />

    <!-- Input Detail -->
    <div class="space-y-3">
      <div class="grid grid-cols-2 gap-2.5">
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Kota</label>
          <input type="text" id="inputKota" value="Jakarta" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs" />
        </div>
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Tanggal</label>
          <input type="text" id="inputTanggal" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-2.5">
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Nomor Surat</label>
          <input type="text" id="inputNomor" placeholder="012/HRD/2026" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs" />
        </div>
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Perihal</label>
          <input type="text" id="inputPerihal" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs" />
        </div>
      </div>

      <div>
        <label class="block text-[11px] text-slate-600 mb-0.5">Penerima Surat</label>
        <textarea id="inputTujuan" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs"></textarea>
      </div>

      <div>
        <label class="block text-[11px] text-slate-600 mb-0.5">Isi Pesan Surat</label>
        <textarea id="inputIsi" rows="8" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs leading-relaxed"></textarea>
      </div>

      <div class="grid grid-cols-2 gap-2.5">
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Pengirim</label>
          <input type="text" id="inputPengirim" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs" />
        </div>
        <div>
          <label class="block text-[11px] text-slate-600 mb-0.5">Jabatan</label>
          <input type="text" id="inputJabatan" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs" />
        </div>
      </div>

      <div class="flex items-center gap-2 pt-1">
        <input type="checkbox" id="toggleMaterai" class="w-4 h-4 text-blue-600 rounded border-slate-300" />
        <label for="toggleMaterai" class="text-xs text-slate-700 cursor-pointer">Sertakan kotak materai (Rp 10.000)</label>
      </div>
    </div>
  </div>

  <!-- A4 Preview Section -->
  <div id="previewSection" class="hidden lg:block lg:col-span-7 w-full overflow-x-auto pb-10">
    <div class="flex justify-end gap-2 mb-3 no-print">
      <button id="btnCopy" class="px-3.5 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg flex items-center gap-1.5 shadow-xs">
        <i class="fa-regular fa-copy"></i> Salin Teks
      </button>
      <button onclick="window.print()" class="px-4 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg flex items-center gap-1.5 shadow-xs">
        <i class="fa-solid fa-print"></i> Cetak Dokumen
      </button>
    </div>

    <div class="sheet-a4 text-slate-900 flex flex-col justify-between rounded-md" id="letterPaper">
      <div>
        <div id="renderKop" class="hidden mb-6 text-center border-b-2 border-slate-900 pb-3">
          <h2 id="viewKopNama" class="text-base sm:text-lg font-bold uppercase tracking-wide"></h2>
          <p id="viewKopAlamat" class="text-[11px] sm:text-xs mt-0.5 text-slate-700"></p>
          <p id="viewKopKontak" class="text-[10px] sm:text-[11px] text-slate-600"></p>
        </div>

        <div class="flex justify-between items-start mb-6 text-xs">
          <div id="renderNomorGroup" class="space-y-0.5 hidden">
            <div>Nomor : <span id="viewNomor"></span></div>
            <div>Perihal : <span id="viewPerihal" class="font-semibold"></span></div>
          </div>
          <div class="ml-auto text-right">
            <span id="viewKota"></span>, <span id="viewTanggal"></span>
          </div>
        </div>

        <div class="mb-6 text-xs leading-relaxed whitespace-pre-line" id="viewTujuan"></div>
        <div class="text-xs leading-relaxed text-justify whitespace-pre-line space-y-4" id="viewIsi"></div>
      </div>

      <div class="mt-12 flex justify-end">
        <div class="text-center w-52 sm:w-56 text-xs flex flex-col items-center">
          <p>Hormat saya,</p>
          <div id="viewMaterai" class="hidden my-2 w-28 h-16 border-2 border-dashed border-slate-300 flex items-center justify-center text-[10px] text-slate-400 font-sans">
            MATERAI 10.000
          </div>
          <div id="spacerNoMaterai" class="h-16 sm:h-20"></div>
          <p id="viewPengirim" class="font-bold underline decoration-1 underline-offset-4"></p>
          <p id="viewJabatan" class="text-slate-600 mt-0.5"></p>
        </div>
      </div>
    </div>
  </div>
</main>

<script src="/js/app.js"></script>
<%- include('partials/footer') %>