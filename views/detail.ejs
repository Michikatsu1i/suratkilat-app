<%- include('partials/header') %>

<div class="no-print max-w-7xl mx-auto w-full px-4 pt-4 flex justify-between items-center">
  <a href="/history" class="text-xs font-semibold text-slate-600 hover:text-slate-900 flex items-center gap-1.5">
    <i class="fa-solid fa-arrow-left"></i> Kembali ke Riwayat
  </a>
  <button onclick="window.print()" class="px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg flex items-center gap-2 shadow-xs">
    <i class="fa-solid fa-print"></i> Cetak / Simpan PDF
  </button>
</div>

<main class="max-w-7xl mx-auto w-full p-4 sm:p-6 flex justify-center">
  <div class="sheet-a4 text-slate-900 flex flex-col justify-between rounded-md <%= letter.font_family %> <%= letter.font_size %>">
    <div>
      <% if (letter.has_kop) { %>
        <div class="mb-6 text-center border-b-2 border-slate-900 pb-3">
          <h2 class="text-base sm:text-lg font-bold uppercase tracking-wide"><%= letter.kop_nama %></h2>
          <p class="text-[11px] sm:text-xs mt-0.5 text-slate-700"><%= letter.kop_alamat %></p>
          <p class="text-[10px] sm:text-[11px] text-slate-600"><%= letter.kop_kontak %></p>
        </div>
      <% } %>

      <div class="flex justify-between items-start mb-6 text-xs">
        <div class="space-y-0.5 <%= (!letter.nomor_surat && !letter.perihal) ? 'hidden' : '' %>">
          <div>Nomor : <span><%= letter.nomor_surat || '-' %></span></div>
          <div>Perihal : <span class="font-semibold"><%= letter.perihal || '-' %></span></div>
        </div>
        <div class="ml-auto text-right">
          <%= letter.kota %>, <%= letter.tanggal %>
        </div>
      </div>

      <div class="mb-6 text-xs leading-relaxed whitespace-pre-line"><%= letter.tujuan %></div>
      <div class="text-xs leading-relaxed text-justify whitespace-pre-line space-y-4"><%= letter.isi_surat %></div>
    </div>

    <div class="mt-12 flex justify-end">
      <div class="text-center w-52 sm:w-56 text-xs flex flex-col items-center">
        <p>Hormat saya,</p>
        <% if (letter.has_materai) { %>
          <div class="my-2 w-28 h-16 border-2 border-dashed border-slate-300 flex items-center justify-center text-[10px] text-slate-400 font-sans">
            MATERAI 10.000
          </div>
        <% } else { %>
          <div class="h-16 sm:h-20"></div>
        <% } %>
        <p class="font-bold underline decoration-1 underline-offset-4"><%= letter.pengirim %></p>
        <p class="text-slate-600 mt-0.5"><%= letter.jabatan %></p>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>