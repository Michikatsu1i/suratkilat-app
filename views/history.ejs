<%- include('partials/header') %>

<main class="max-w-7xl mx-auto w-full p-4 sm:p-6 flex-1">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-xl font-bold text-slate-900">Arsip Riwayat Surat</h2>
      <p class="text-xs text-slate-500">Semua surat yang pernah dibuat dan disimpan ke database lokal</p>
    </div>
    <a href="/" class="px-4 py-2 text-xs font-semibold bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-2">
      <i class="fa-solid fa-plus"></i> Buat Surat Baru
    </a>
  </div>

  <% if (letters.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center text-slate-400">
      <i class="fa-regular fa-folder-open text-4xl mb-3"></i>
      <p class="text-sm">Belum ada arsip surat yang tersimpan.</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% letters.forEach(item => { %>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start gap-2 mb-2">
              <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md bg-blue-50 text-blue-600">
                <%= item.letter_type %>
              </span>
              <span class="text-[11px] text-slate-400">
                <%= new Date(item.created_at).toLocaleDateString('id-ID') %>
              </span>
            </div>
            <h3 class="text-sm font-bold text-slate-900 line-clamp-1 mb-1"><%= item.perihal || item.title %></h3>
            <p class="text-xs text-slate-500 line-clamp-2 mb-4"><%= item.isi_surat %></p>
          </div>
          
          <div class="border-t border-slate-100 pt-3 flex items-center justify-between text-xs">
            <span class="font-medium text-slate-700 truncate max-w-[140px]"><%= item.pengirim %></span>
            <div class="flex items-center gap-2">
              <a href="/letter/<%= item.id %>" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 rounded-md text-slate-700 font-semibold">
                Buka
              </a>
              <button onclick="deleteLetter(<%= item.id %>)" class="text-rose-500 hover:text-rose-700 p-1">
                <i class="fa-regular fa-trash-can"></i>
              </button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<script>
  async function deleteLetter(id) {
    if (!confirm('Apakah Anda yakin ingin menghapus surat ini dari arsip?')) return;
    const res = await fetch(`/api/letters/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert('Gagal menghapus: ' + data.message);
    }
  }
</script>

<%- include('partials/footer') %>